		"@types/fs-extra": "^11.0.4",
		"@types/glob-watcher": "^5.0.5",
		"fs-extra": "11.4.1",
		"glob": "13.0.6",
		"glob-watcher": "6.0.0",
		"happy-dom": "21.0.3",
		"htm": "^3.1.1",
		"nouislider": "^15.8.1",
		"preact": "11.0.1",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"sharp": "0.35.5",
		"sneer": "1.0.1",
